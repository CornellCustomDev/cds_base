<div class="card">
  <div class="{{ card_image ? 'group-image' : 'group-noimage' }}">
    {% if card_url %}
      <a href="{{ card_url }}">
    {% endif %}
      {% if card_image is defined and card_image is not empty %}
        {# Images from the media library.  We suppress alt since the adjacent link text has precedence #}
        <img src="{{ card_image.src }}" alt="" />
      {% endif %}
      {% if card_badge and card_image %}
        <div class="badge">
          {{ card_badge }}
        </div>
      {% endif %}
      {% if card_title %}
        {# Card title. Heading level defined in the component. #}
        <div class="overlay">
          <{{ card_title_h_level|default('h3') }}>
            <span class="deco">
              {{ card_title }}
            </span>
          </{{ card_title_h_level|default('h3') }}>
        </div>
      {% endif %}
    {% if card_url %}
      </a>
    {% endif %}
  </div>
  <div class="group-fields">
    {% if card_subheading %}
      <strong>{{ card_subheading }}</strong>
    {% endif %}
    {% if card_text %}
      <div class="field summary">
        {{ card_text }}
      </div>
    {% endif %}
    {# Note: In the future, taxonomies/tags for a card should be added here. #}
  </div>
</div>
